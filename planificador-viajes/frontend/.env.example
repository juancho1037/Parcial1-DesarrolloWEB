# API URLs
VITE_API_URL=http://localhost:3000/api
VITE_BASE_URL=http://localhost:5173

# Autenticación
VITE_JWT_SECRET=your_jwt_secret_key
VITE_JWT_EXPIRATION=24h

# Configuración de servicios externos
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_MAPBOX_TOKEN=your_mapbox_token

# Configuración de almacenamiento
VITE_STORAGE_PREFIX=travel_planner_

# Configuración de características
VITE_ENABLE_SOCIAL_LOGIN=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Limites y restricciones
VITE_MAX_UPLOAD_SIZE=5242880
VITE_MAX_TRIPS_PER_USER=10
VITE_MAX_IMAGES_PER_TRIP=20

# Configuración de caché
VITE_CACHE_DURATION=3600
VITE_CACHE_VERSION=1.0

# Configuración de idioma
VITE_DEFAULT_LANGUAGE=es
VITE_AVAILABLE_LANGUAGES=es,en,fr

# Modo de desarrollo
VITE_DEV_MODE=true
VITE_MOCK_API=false

# Endpoints específicos
VITE_AUTH_ENDPOINT=/auth
VITE_TRIPS_ENDPOINT=/trips
VITE_USERS_ENDPOINT=/users
VITE_DESTINATIONS_ENDPOINT=/destinations