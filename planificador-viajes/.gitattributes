# Auto detect text files and perform LF normalization
* text=auto

# JS/TS files must keep LF endings
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.vue text eol=lf

# CSS files must keep LF endings
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf

# HTML files must keep LF endings
*.html text eol=lf

# Documents
*.md text diff=markdown
*.txt text
*.json text

# Graphics
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text

# Font files
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary

# Include npm lock file
package-lock.json -diff

# RC files
.* text

# Config files must keep LF endings
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf