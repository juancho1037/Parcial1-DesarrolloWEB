erDiagram
    USUARIOS ||--o{ VIAJES : crea
    USUARIOS ||--o{ RESENAS : escribe
    USUARIOS ||--o{ FAVORITOS : marca
    VIAJES ||--|{ ACTIVIDADES_VIAJE : contiene
    DESTINOS ||--o{ VIAJES : tiene
    DESTINOS ||--o{ RESENAS : recibe
    DESTINOS ||--o{ EXPERIENCIAS : ofrece
    DESTINOS }|--|| CATEGORIAS : pertenece
    ACTIVIDADES ||--o{ ACTIVIDADES_VIAJE : incluye

    USUARIOS {
        int id PK
        string nombre
        string email
        string password
    }

    VIAJES {
        int id PK
        int usuario_id FK
        int destino_id FK
        date fecha_inicio
        date fecha_fin
    }

    DESTINOS {
        int id PK
        int categoria_id FK
        string nombre
        string descripcion
        float calificacion
    }

    CATEGORIAS {
        int id PK
        string nombre
        string descripcion
    }

    ACTIVIDADES {
        int id PK
        string nombre
        string descripcion
        float duracion
    }

    ACTIVIDADES_VIAJE {
        int id PK
        int viaje_id FK
        int actividad_id FK
        int dia_itinerario
    }

    RESENAS {
        int id PK
        int usuario_id FK
        int destino_id FK
        int calificacion
        string comentario
    }

    EXPERIENCIAS {
        int id PK
        int destino_id FK
        string titulo
        string descripcion
    }

    FAVORITOS {
        int id PK
        int usuario_id FK
        int destino_id FK
    }
